{
  "name": "gatekeeper-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-quality authorization and feature-flag toolkit for full-stack TypeScript applications",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"api,dashboard\" -c \"cyan,magenta\" \"pnpm --filter demo-api dev\" \"pnpm --filter demo-dashboard dev\"",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
