{
  "name": "@ahmedtamer/gatekeeper-express",
  "version": "0.1.0",
  "description": "Express middleware for authorization and feature flags with customizable callbacks powered by Gatekeeper Core",
  "keywords": [
    "express",
    "middleware",
    "authorization",
    "rbac",
    "permissions",
    "feature-flags"
  ],
  "author": "Ahmed Tamer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed1092002/npm-packages.git",
    "directory": "gatekeeper/packages/express"
  },
  "bugs": {
    "url": "https://github.com/Ahmed1092002/npm-packages/issues"
  },
  "homepage": "https://github.com/Ahmed1092002/npm-packages/tree/main/gatekeeper#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external express,@ahmedtamer/gatekeeper-core",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external express,@ahmedtamer/gatekeeper-core",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "express": ">=4.18.0"
  },
  "dependencies": {
    "@ahmedtamer/gatekeeper-core": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "express": "^4.21.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
