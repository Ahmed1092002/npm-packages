{
  "name": "@gatekeeper/express",
  "version": "1.0.0",
  "description": "Express middleware for authorization and feature flags powered by Gatekeeper Core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external express",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external express",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "express": ">=4.18.0"
  },
  "dependencies": {
    "@gatekeeper/core": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "express": "^4.21.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
