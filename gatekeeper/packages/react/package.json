{
  "name": "@ahmed109/gatekeeper-react",
  "version": "0.2.0",
  "description": "React authorization and feature-flag toolkit with fail-safe loading state powered by Gatekeeper Core",
  "keywords": [
    "react",
    "authorization",
    "permissions",
    "feature-flags",
    "rbac",
    "hooks",
    "components"
  ],
  "author": "Ahmed Tamer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed1092002/npm-packages.git",
    "directory": "gatekeeper/packages/react"
  },
  "bugs": {
    "url": "https://github.com/Ahmed1092002/npm-packages/issues"
  },
  "homepage": "https://github.com/Ahmed1092002/npm-packages/tree/main/gatekeeper#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react,react-dom,@ahmed109/gatekeeper-core",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react,react-dom,@ahmed109/gatekeeper-core",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@ahmed109/gatekeeper-core": "workspace:^0.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
